<Project Sdk="Microsoft.NET.Sdk">

  <!-- Defines MonacoEditorWinUI3WindowsSdkPackageVersion (shared with the packaged consumer check). -->
  <Import Project="buildTransitive\MonacoEditor.WinUI3.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!--
      Pin the Windows SDK projection explicitly. Left implicit, it follows whichever .NET SDK runs
      the build (SDK 11 picks a newer projection than SDK 10), which leaks a newer WinRT.Runtime
      requirement to consumers and breaks them with CS1705. See buildTransitive\MonacoEditor.WinUI3.props.
    -->
    <WindowsSdkPackageVersion>$(MonacoEditorWinUI3WindowsSdkPackageVersion)</WindowsSdkPackageVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MonacoEditor.WinUI3</RootNamespace>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Metadata -->
    <PackageId>MonacoEditor.WinUI3</PackageId>
    <Version>0.6.1-monaco.0.58.0</Version>
    <Authors>luttje</Authors>
    <Company>luttje</Company>
    <Description>Monaco Editor (VS Code's editor) wrapped as a WinUI 3 control with two-way text
      binding via WebView2.</Description>
    <PackageTags>monaco;editor;winui3;webview2;code-editor;vscode</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/luttje/MonacoEditor.WinUI3</PackageProjectUrl>
    <RepositoryUrl>https://github.com/luttje/MonacoEditor.WinUI3</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeContentInPack>true</IncludeContentInPack>

    <!-- Suppress platform-specific warnings for library packaging -->
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <!-- Embed the Monaco web assets into the package -->
  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" />
    <None Include="Web\**\*">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\MonacoWeb\</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="buildTransitive\MonacoEditor.WinUI3.props;buildTransitive\MonacoEditor.WinUI3.targets" Pack="true" PackagePath="buildTransitive\;build\" />
  </ItemGroup>

</Project>